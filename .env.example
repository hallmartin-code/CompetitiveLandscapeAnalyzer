# Copy to `.env` and fill in. Every value below is optional except the API key,
# and the application runs (in reduced-confidence heuristic mode) without that.
# Never commit a filled-in .env.

# ---------------------------------------------------------------------------
# Deployment (Railway) — see DEPLOY.md
# ---------------------------------------------------------------------------

# Gates the Streamlit UI behind a password. Strongly advised for any public
# deployment: the instance holds a live API key and each run costs real money.
# Unset, the app displays a visible warning rather than failing closed.
# APP_PASSWORD=

# PORT is injected by Railway. Do not set it yourself.

# ---------------------------------------------------------------------------
# Model access
# ---------------------------------------------------------------------------

# Anthropic API key. Without it the app falls back to deterministic keyword
# extraction and cannot perform competitor discovery or competitive assessment.
ANTHROPIC_API_KEY=sk-ant-...

# Model id. Defaults to the most capable model, because this output informs
# investment decisions. Alternatives: claude-sonnet-5, claude-haiku-4-5.
CI_MODEL=claude-opus-5

# Reasoning effort: low | medium | high | xhigh | max.
# 'high' is the default and the right setting for most decks. Raise to 'xhigh'
# for unusually complex or technical markets; lower to 'medium' to cut cost.
CI_EFFORT=high

# Ceiling on model output tokens per call, and request timeout in seconds.
CI_MAX_TOKENS=32000
CI_TIMEOUT=600
CI_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Public research
# ---------------------------------------------------------------------------

# Operator-level switch. Research ALSO requires per-run user consent, so
# setting this true does not by itself cause any outbound request.
CI_RESEARCH_ENABLED=true

# Comma-separated approved source domains. Anything not on this list is refused
# and recorded as a diagnostic. Note that some publishers (reuters.com, wsj.com,
# ft.com) block the research crawler and will be dropped automatically.
# CI_SOURCE_ALLOWLIST=sec.gov,crunchbase.com,techcrunch.com,cms.gov

# ---------------------------------------------------------------------------
# Analysis tuning
# ---------------------------------------------------------------------------

CI_MIN_COMPETITORS=4
CI_MAX_COMPETITORS=12
CI_MATRIX_ROWS=6          # competitors shown in the one-page matrix (4-7)
CI_WHITESPACE=4
CI_CONCERNS=5
CI_MAX_TRANSCRIPT_CHARS=120000

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

CI_OUTPUT_DIR=outputs
CI_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Email delivery (Resend)
# ---------------------------------------------------------------------------

# Resend API key. With this set, every completed analysis is emailed
# automatically with the PDF and JSON record attached.
# RESEND_API_KEY=re_...

# Master switch. Set false to keep the key configured but stop all sending.
EMAIL_ENABLED=true

# Recipients, comma separated.
EMAIL_TO=Info@tencapital.group

# Sender. MUST be on a domain verified in your Resend account, or the API
# rejects the send. Verify the domain at resend.com/domains first.
EMAIL_FROM=TEN Capital Decision Intelligence <reports@tencapital.group>

# Optional reply-to, and attachment toggles.
# EMAIL_REPLY_TO=
EMAIL_ATTACH_PDF=true
EMAIL_ATTACH_JSON=true

# ---------------------------------------------------------------------------
# TEN Capital CRM (optional)
# ---------------------------------------------------------------------------

# Where the JSON record may be POSTed. Transmission ALSO requires the user to
# explicitly authorise it for that run. Leave unset to guarantee that nothing
# ever leaves the machine.
# TEN_CRM_ENDPOINT=https://crm.example.internal/api/competitive-intelligence
# TEN_CRM_API_KEY=
